# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Catat Money

# Supabase project (server-side values; keep service role key secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Browser client (anon key only; access is protected by database RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Date interpretation for phrases such as "tadi malam" and "kemarin"
APP_TIMEZONE=Asia/Makassar

# Telegram bot (used in a later integration step)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret_at_least_32_characters
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
